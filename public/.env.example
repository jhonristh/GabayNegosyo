# GabayNegosyo — environment variables
# The app runs fully in DEMO MODE with none of these set: local auth,
# local data layer, and mock email all work with zero configuration.
# Copy this file to .env.local and fill in values only when you're ready
# to connect real infrastructure.

# ── Supabase (auth + database) ──────────────────────────────────────────
# Leave unset to keep using the local demo auth (lib/auth.tsx) and local
# data layer (lib/db.ts). Setting these does NOT automatically switch the
# app over — see README "Supabase setup" for the migration steps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google OAuth (via Supabase Auth) ────────────────────────────────────
# Configured inside your Supabase project dashboard, not here. Listed for
# reference — see README "Google OAuth setup".
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email provider (reminders) ──────────────────────────────────────────
# Leave unset to keep reminder emails in mock mode (logged to the admin
# dashboard's "Recent reminder emails sent" panel instead of actually sent).
NEXT_PUBLIC_EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_ENDPOINT=

# ── Resource data source (optional) ─────────────────────────────────────
# If unset, requirement/resource content comes from data/*.json and any
# admin edits stored in the browser's localStorage.
NEXT_PUBLIC_RESOURCES_SHEET_URL=
