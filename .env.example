# Copy to .env.local and supply your own project values. Never commit secrets.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_TEAM_NAME=
# Browser-local sample accounts. Enable only for previews.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Automated reminders remain disabled in this version.
REMINDERS_MODE=off
CRON_SECRET=
REMINDER_ALLOWLIST=
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
