# GabayNegosyo — environment variables
# Copy this file to .env.local (local dev) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local, and never put secrets in a variable that starts with NEXT_PUBLIC_
# (those are bundled into the browser).

# ── Supabase (required) ─────────────────────────────────────────────────
# Supabase dashboard → your project → Connect (or Settings → API Keys).
# The key below is the PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key.
# Both are safe in the browser; Row Level Security protects the data.
# DO NOT use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-or-anon-key>

# ── Google sign-in (optional) ───────────────────────────────────────────
# Set to "true" only AFTER the Google provider is enabled in Supabase.
# The Google client ID/secret go inside the Supabase dashboard, not here.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# ── Browser-only demo mode (optional) ───────────────────────────────────
# Shows Free / Premium / Admin PREVIEW buttons on the login page. Demo mode is not a
# Supabase session: it creates no users or profiles, needs no password, stores sample
# data only in the visitor's browser, and the admin preview has no real admin access.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false

# ── Account deletion (server-side only) ─────────────────────────────────
# Needed ONLY by /api/delete-account. Supabase dashboard → Settings → API Keys →
# secret / service_role key. Set it in Vercel (Production + Preview as needed).
# NEVER prefix with NEXT_PUBLIC_, never commit it, never paste it into source files.
# Without it the Delete Account button reports "not available" and deletes nothing.
SUPABASE_SERVICE_ROLE_KEY=

# ── Reminder emails (optional, server-side only) ────────────────────────
# Leave both empty to stay in mock mode (emails are logged, not delivered).
RESEND_API_KEY=
EMAIL_FROM=GabayNegosyo <reminders@your-verified-domain>

# ── Site config (L15) ────────────────────────────────────────────────────
# Read by lib/siteConfig.ts. scripts/check-env.mjs WARNS if these are
# missing locally, and FAILS the build in production (VERCEL_ENV=production)
# — see that script for exactly what breaks without each one.
# Used in: page metadata, Open Graph tags, robots.txt, sitemap.xml.
# The public https URL of the deployed site (no trailing slash needed). Used for emailed
# confirmation links and Google sign-in return URLs. It must ALSO be allowed in
# Supabase → Authentication → URL Configuration (see docs/SUPABASE_REDIRECT_SETUP.md).
NEXT_PUBLIC_SITE_URL=
# Used on: 404 page, and will be used on the Privacy/Terms/Disclaimer pages
# once those are built (L12). This must be a real, monitored address —
# never invent one.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional — shown on legal pages once built, if set.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_TEAM_NAME=
# Optional — e.g. "₱99–₱199/month". Leave empty and the Premium upsell
# shows "Prototype: upgrading is simulated and no payment is taken."
# instead of a price nobody has confirmed (see WP11, C5).
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=

# ── Error tracking (optional, B4) ───────────────────────────────────────
# lib/observability.ts forwards to an error-tracking service only when this
# is set. Empty by default: no third-party account has been created — see
# docs/V0.3_STATUS.md.
NEXT_PUBLIC_ERROR_TRACKING_DSN=
